  .top-badges { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin-bottom: 10px; }
  .author-badge { background: linear-gradient(90deg, #2a75bb, #1e3c72); color: #ffcb05; font-size: 12px; font-weight: bold; padding: 4px 12px; border-radius: 20px; border: 1px solid #ffcb05; }
  .kanto-master-badge { background: linear-gradient(90deg, #ffd700, #ff8f00); color: #14171d; font-size: 12px; font-weight: bold; padding: 4px 12px; border-radius: 20px; border: 1px solid #fff; box-shadow: 0 0 12px rgba(255,215,0,0.6); }
