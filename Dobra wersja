<script>
const KANTO_NAMES = ["","Bulbasaur","Ivysaur","Venusaur","Charmander","Charmeleon","Charizard","Squirtle","Wartortle","Blastoise","Caterpie","Metapod","Butterfree","Weedle","Kakuna","Beedrill","Pidgey","Pidgeotto","Pidgeot","Rattata","Raticate","Spearow","Fearow","Ekans","Arbok","Pikachu","Raichu","Sandshrew","Sandslash","Nidoran♀","Nidorina","Nidoqueen","Nidoran♂","Nidorino","Nidoking","Clefairy","Clefable","Vulpix","Ninetales","Jigglypuff","Wigglytuff","Zubat","Golbat","Oddish","Gloom","Vileplume","Paras","Parasect","Venonat","Venomoth","Diglett","Dugtrio","Meowth","Persian","Psyduck","Golduck","Mankey","Primeape","Growlithe","Arcanine","Poliwag","Poliwhirl","Poliwrath","Abra","Kadabra","Alakazam","Machop","Machoke","Machamp","Bellsprout","Weepinbell","Victreebel","Tentacool","Tentacruel","Geodude","Graveler","Golem","Ponyta","Rapidash","Slowpoke","Slowbro","Magnemite","Magneton","Farfetch'd","Doduo","Dodrio","Seel","Dewgong","Grimer","Muk","Shellder","Cloyster","Gastly","Haunter","Gengar","Onix","Drowzee","Hypno","Krabby","Kingler","Voltorb","Electrode","Exeggcute","Exeggutor","Cubone","Marowak","Hitmonlee","Hitmonchan","Lickitung","Koffing","Weezing","Rhyhorn","Rhydon","Chansey","Tangela","Kangaskhan","Horsea","Seadra","Goldeen","Seaking","Staryu","Starmie","Mr. Mime","Scyther","Jynx","Electabuzz","Magmar","Pinsir","Tauros","Magikarp","Gyarados","Lapras","Ditto","Eevee","Vaporeon","Jolteon","Flareon","Porygon","Omanyte","Omastar","Kabuto","Kabutops","Aerodactyl","Snorlax","Articuno","Zapdos","Moltres","Dratini","Dragonair","Dragonite","Mewtwo","Mew"];
const EVOLUTIONS = {1:[2,300],2:[3,1500],4:[5,300],5:[6,1500],7:[8,300],8:[9,1500],10:[11,150],11:[12,600],13:[14,150],14:[15,600],16:[17,350],17:[18,1600],19:[20,400],21:[22,550],23:[24,650],25:[26,2000],27:[28,750],29:[30,450],30:[31,2200],32:[33,450],33:[34,2200],35:[36,1400],37:[38,1500],39:[40,1300],41:[42,700],43:[44,500],44:[45,2000],46:[47,750],48:[49,850],50:[51,950],52:[53,1000],54:[55,1100],56:[57,1100],58:[59,2800],60:[61,600],61:[62,2400],63:[64,900],64:[65,3800],66:[67,900],67:[68,3800],69:[70,600],70:[71,2400],72:[73,1200],74:[75,850],75:[76,3200],77:[78,1600],79:[80,1500],81:[82,1400],84:[85,1200],86:[87,1500],88:[89,1600],90:[91,1800],92:[93,1200],93:[94,4500],96:[97,1200],98:[99,1300],100:[101,1400],102:[103,2200],104:[105,1500],109:[110,1600],111:[112,2500],116:[117,1500],118:[119,1200],120:[121,2200],129:[130,5000],133:[134,2500],138:[139,3000],140:[141,3000],147:[148,6000],148:[149,20000]};
const LEGENDARY_IDS = [144,145,146,150,151];
const RARE_IDS = [3,6,9,65,68,76,94,112,130,131,134,135,136,142,143,149];

const GYMS = [
  { id: 0, leader: "Brock", badge: "🪨 Odznaka Głazu", poke: 95, hp: 250, reward: 500 },
  { id: 1, leader: "Misty", badge: "💧 Odznaka Kaskady", poke: 121, hp: 900, reward: 1400 },
  { id: 2, leader: "Lt. Surge", badge: "⚡ Odznaka Pioruna", poke: 26, hp: 2600, reward: 3200 },
  { id: 3, leader: "Erika", badge: "🌿 Odznaka Tęczy", poke: 45, hp: 6500, reward: 7000 },
  { id: 4, leader: "Koga", badge: "☠️ Odznaka Duszy", poke: 110, hp: 15000, reward: 15000 },
  { id: 5, leader: "Sabrina", badge: "🔮 Odznaka Bagna", poke: 65, hp: 35000, reward: 32000 },
  { id: 6, leader: "Blaine", badge: "🔥 Odznaka Wulkanu", poke: 59, hp: 80000, reward: 70000 },
  { id: 7, leader: "Giovanni", badge: "🌍 Odznaka Ziemi", poke: 112, hp: 180000, reward: 160000 }
];

const BALL_TYPES = {
  poke: { name: "Poké Ball", price: 150, mult: 1.0, icon: "🔴" },
  great: { name: "Great Ball", price: 400, mult: 1.5, icon: "🔵" },
  ultra: { name: "Ultra Ball", price: 1000, mult: 2.2, icon: "🟡" },
  master: { name: "Master Ball", price: 12000, mult: 999, icon: "🟣" }
};

const SAVE_KEY = "pokeclicker_kanto_v6";
const BACKUP_KEY = "pokeclicker_kanto_v6_backup";

let state = { coins: 0, balls: 3, ballBag: { poke: 3, great: 0, ultra: 0, master: 0 }, activeDex: 1, team: [], caught: [], shinyCaught: [], badges: [], multLevel: 0, shinyCharmLevel: 0 };
let wildPokemon = null, currentTab = "train", comboEnergy = 0, toastTimer = null, activeGymBattle = null, gymTimerInterval = null;

function showToast(msg) {
  const el = document.getElementById("toast-msg");
  el.innerText = msg; el.classList.remove("hidden");
  clearTimeout(toastTimer); toastTimer = setTimeout(() => el.classList.add("hidden"), 2600);
}

const isShiny = d => Array.isArray(state.shinyCaught) && state.shinyCaught.includes(d);
const hasKantoBadge = () => Array.isArray(state.caught) && state.caught.length >= 151;
const getTotalBalls = () => { const b = state.ballBag || { poke: state.balls || 0, great: 0, ultra: 0, master: 0 }; return (b.poke || 0) + (b.great || 0) + (b.ultra || 0) + (b.master || 0); };
const getBasePower = d => { const base = LEGENDARY_IDS.includes(d) ? 180 : RARE_IDS.includes(d) ? 55 : Math.max(1, Math.floor(d / 12)) * (!EVOLUTIONS[d] ? 2 : 1); return isShiny(d) ? base * 2 : base; };
const getTransferValue = d => Math.max(40, getBasePower(d) * 15);
const getPermMult = () => 1 + (state.multLevel * 0.5) + ((Array.isArray(state.badges) ? state.badges.length : 0) * 0.3) + (hasKantoBadge() ? 2.0 : 0);
const getComboMult = () => 1 + (Math.floor(comboEnergy / 25) * 0.5);
const getClickPower = d => Math.max(1, Math.round(getBasePower(d) * getPermMult() * getComboMult()));
const getMultPrice = () => Math.round(250 * Math.pow(1.8, state.multLevel));
const getShinyCharmPrice = () => Math.round(1000 * Math.pow(2.2, state.shinyCharmLevel || 0));
const getShinyChance = () => Math.min(0.50, 0.15 + ((state.shinyCharmLevel || 0) * 0.05));
const getSprite = (d, shiny = false) => shiny ? `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/shiny/${d}.png` : `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${d}.png`;

setInterval(() => { if (comboEnergy > 0) { comboEnergy = Math.max(0, comboEnergy - 4); updateComboUI(); } }, 150);
setInterval(() => { if (state.team && state.team.length > 0) saveGame(true); }, 3000);
window.addEventListener("beforeunload", () => { if (state.team && state.team.length > 0) saveGame(true); });
document.addEventListener("visibilitychange", () => { if (document.hidden && state.team && state.team.length > 0) saveGame(true); });

function updateComboUI() {
  const fill = document.getElementById("combo-fill");
  if (!fill) return;
  fill.style.width = comboEnergy + "%";
  document.getElementById("combo-mult-text").innerText = getComboMult().toFixed(1);
  document.getElementById("total-mult-text").innerText = (getComboMult() * getPermMult()).toFixed(1);
  if (state.team.length > 0) document.getElementById("click-power-text").innerText = getClickPower(state.activeDex);
}
function saveGame(silent = false) {
  try {
    state.balls = getTotalBalls(); state.lastSaved = Date.now();
    const json = JSON.stringify(state);
    localStorage.setItem(SAVE_KEY, json); localStorage.setItem(BACKUP_KEY, json);
    if (!silent) {
      const st = document.getElementById("save-status-text");
      if (st) { const n = new Date(); st.innerText = `💾 Zapisano automatycznie (${String(n.getHours()).padStart(2,'0')}:${String(n.getMinutes()).padStart(2,'0')}:${String(n.getSeconds()).padStart(2,'0')})`; }
    }
  } catch (e) {}
}
function parseSavedData(raw) { if (!raw) return null; const p = JSON.parse(raw); return (p && Array.isArray(p.team) && p.team.length > 0) ? p : null; }
function loadGame() {
  try {
    let loaded = parseSavedData(localStorage.getItem(SAVE_KEY)) || parseSavedData(localStorage.getItem(BACKUP_KEY));
    if (loaded) {
      state = { coins: 0, balls: 3, activeDex: 1, team: [], caught: [], shinyCaught: [], badges: [], multLevel: 0, shinyCharmLevel: 0, ...loaded };
      if (!state.ballBag) state.ballBag = { poke: loaded.balls || 0, great: 0, ultra: 0, master: 0 };
      if (!Array.isArray(state.shinyCaught)) state.shinyCaught = [];
      if (!Array.isArray(state.badges)) state.badges = [];
      saveGame(true);
      document.getElementById("starter-screen").classList.add("hidden");
      document.getElementById("game-screen").classList.remove("hidden");
      render(); return;
    }
  } catch (e) {}
  document.getElementById("starter-screen").classList.remove("hidden");
}
function startWithStarter(dex) {
  const s = Math.random() < 0.25;
  state = { coins: 0, balls: 3, ballBag: { poke: 3, great: 0, ultra: 0, master: 0 }, activeDex: dex, team: [dex], caught: [dex], shinyCaught: s ? [dex] : [], badges: [], multLevel: 0, shinyCharmLevel: 0 };
  saveGame();
  document.getElementById("starter-screen").classList.add("hidden");
  document.getElementById("game-screen").classList.remove("hidden");
  showToast(s ? `✨ WOW! Trafiłeś SHINY ${KANTO_NAMES[dex]}!` : `Wybrałeś ${KANTO_NAMES[dex]}!`);
  render();
}
function clickPoke() {
  comboEnergy = Math.min(100, comboEnergy + 9);
  state.coins += getClickPower(state.activeDex);
  if (!wildPokemon && Math.random() < 0.14) {
    let dex = Math.floor(Math.random() * 151) + 1;
    if (LEGENDARY_IDS.includes(dex) && Math.random() < 0.8) dex = Math.floor(Math.random() * 143) + 1;
    const sh = Math.random() < getShinyChance();
    wildPokemon = { dex: dex, shiny: sh, catchRate: LEGENDARY_IDS.includes(dex) ? 0.22 : RARE_IDS.includes(dex) ? 0.38 : 0.60, tries: sh ? 4 : 3 };
    if (sh) showToast(`✨ DZIKI SHINY ${KANTO_NAMES[dex].toUpperCase()}!`);
  }
  saveGame(); render();
}
function throwBall(type) {
  if (!wildPokemon || !state.ballBag || (state.ballBag[type] || 0) <= 0) return;
  state.ballBag[type]--;
  const chance = type === "master" ? 1.0 : Math.min(0.95, wildPokemon.catchRate * BALL_TYPES[type].mult);
  if (Math.random() < chance) {
    const d = wildPokemon.dex, sh = wildPokemon.shiny, prev = state.caught.length;
    state.team.push(d);
    if (!state.caught.includes(d)) state.caught.push(d);
    if (sh && !state.shinyCaught.includes(d)) state.shinyCaught.push(d);
    wildPokemon = null;
    if (prev < 151 && state.caught.length >= 151) showToast("🏆 GRATULACJE! ZDOBYŁEŚ ODZNAKĘ MISTRZA KANTO (151/151)!");
    else showToast(sh ? `✨🎉 ZŁAPAŁEŚ SHINY: ${KANTO_NAMES[d]} (2x MOC)!` : `🎉 Złapałeś: ${KANTO_NAMES[d]}!`);
  } else if (--wildPokemon.tries <= 0) {
    const n = (wildPokemon.shiny ? "✨ Shiny " : "") + KANTO_NAMES[wildPokemon.dex];
    wildPokemon = null; showToast(`💨 Dziki ${n} uciekł!`);
  } else showToast(`❌ Pudło (${BALL_TYPES[type].name})! Pozostałe próby: ${wildPokemon.tries}`);
  saveGame(); render();
}
function fleeWild() { wildPokemon = null; render(); }
function evolvePoke() {
  const evo = EVOLUTIONS[state.activeDex];
  if (evo && state.coins >= evo[1]) {
    const oldDex = state.activeDex, newDex = evo[0], keepSh = isShiny(oldDex), prev = state.caught.length;
    state.coins -= evo[1];
    const idx = state.team.indexOf(oldDex);
    if (idx !== -1) state.team[idx] = newDex;
    state.activeDex = newDex;
    if (!state.caught.includes(newDex)) state.caught.push(newDex);
    if (keepSh && !state.shinyCaught.includes(newDex)) state.shinyCaught.push(newDex);
    if (prev < 151 && state.caught.length >= 151) showToast("🏆 EWOLUCJA DAŁA CI ODZNAKĘ MISTRZA KANTO (151/151)!");
    else showToast(keepSh ? `✨ Ewolucja w SHINY ${KANTO_NAMES[newDex]}!` : `✨ Ewolucja w ${KANTO_NAMES[newDex]}!`);
    saveGame(); render();}
}
function buyBall(type, qty) {
  const cost = BALL_TYPES[type].price * qty;
  if (state.coins >= cost) { state.coins -= cost; state.ballBag[type] = (state.ballBag[type] || 0) + qty; showToast(`Kupiono ${qty}x ${BALL_TYPES[type].name}!`); saveGame(); render(); }
}
function buyMult() { const p = getMultPrice(); if (state.coins >= p) { state.coins -= p; state.multLevel++; saveGame(); render(); } }
function buyShinyCharm() {
  const p = getShinyCharmPrice();
  if (state.coins >= p && getShinyChance() < 0.50) { state.coins -= p; state.shinyCharmLevel = (state.shinyCharmLevel || 0) + 1; showToast(`✨ Szansa na Shiny wzrosła do ${Math.round(getShinyChance() * 100)}%!`); saveGame(); render(); }
}
function selectPoke(dex) { state.activeDex = dex; saveGame(); switchTab("train"); }
function transferOnePoke(index) {
  if (state.team.length <= 1) return;
  const dex = state.team[index];
  if (dex === state.activeDex && state.team.filter(x => x === dex).length <= 1) { showToast("Nie możesz odesłać swojego jedynego aktywnego Pokémona!"); return; }
  const reward = getTransferValue(dex);
  state.team.splice(index, 1); state.coins += reward;
  showToast(`🔄 Odesłano ${KANTO_NAMES[dex]} do Prof. Oaka (+${reward} 💰)!`);
  saveGame(); render();
}
function transferAllDuplicates() {
  const seen = new Set([state.activeDex]), kept = []; let freed = 0, total = 0, actKept = false;
  for (const d of state.team) {
    if (d === state.activeDex && !actKept) { kept.push(d); actKept = true; }
    else if (!seen.has(d)) { seen.add(d); kept.push(d); }
    else { freed++; total += getTransferValue(d); }
  }
  if (freed === 0) { showToast("Nie masz żadnych powtórek w drużynie!"); return; }
  state.team = kept; state.coins += total;
  showToast(`🔄 Odesłano ${freed} powtórek (+${total} 💰)!`);
  saveGame(); render();
}
function startGymBattle(gymId) {
  const gym = GYMS.find(g => g.id === gymId); if (!gym) return;
  clearInterval(gymTimerInterval);
  activeGymBattle = { gym: gym, currentHp: gym.hp, maxHp: gym.hp, timeLeft: 15.0 };
  gymTimerInterval = setInterval(() => {
    if (!activeGymBattle) { clearInterval(gymTimerInterval); return; }
    activeGymBattle.timeLeft = Math.max(0, activeGymBattle.timeLeft - 0.1);
    updateGymBattleUI();
    if (activeGymBattle.timeLeft <= 0) { const l = activeGymBattle.gym.leader; activeGymBattle = null; clearInterval(gymTimerInterval); showToast(`⏰ Czas minął! ${l} obronił swoją Salę!`); render(); }
  }, 100);
  render();
}
function hitGymBoss() {
  if (!activeGymBattle) return;
  comboEnergy = Math.min(100, comboEnergy + 8);
  activeGymBattle.currentHp = Math.max(0, activeGymBattle.currentHp - getClickPower(state.activeDex));
  updateGymBattleUI();
  if (activeGymBattle.currentHp <= 0) {
    const w = activeGymBattle.gym; activeGymBattle = null; clearInterval(gymTimerInterval); state.coins += w.reward;
    if (!state.badges.includes(w.id)) { state.badges.push(w.id); showToast(`🏅 POKONAŁEŚ ${w.leader.toUpperCase()}! Zdobyto: ${w.badge} (+${w.reward} 💰)!`); }
    else showToast(`🎉 Ponownie pokonałeś ${w.leader}! (+${w.reward} 💰)`);
    saveGame(); render();
  }
}
function updateGymBattleUI() {
  if (!activeGymBattle) return;
  document.getElementById("gym-timer-text").innerText = `Pozostały czas: ${activeGymBattle.timeLeft.toFixed(1)}s`;
  document.getElementById("gym-hp-fill").style.width = ((activeGymBattle.currentHp / activeGymBattle.maxHp) * 100) + "%";
  document.getElementById("gym-hp-text").innerText = `HP: ${activeGymBattle.currentHp} / ${activeGymBattle.maxHp}`;
}
function exportSave() {
  try {
    const code = btoa(unescape(encodeURIComponent(JSON.stringify(state))));
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(code).then(() => showToast("📋 Skopiowano kod zapisu do schowka!"));
    else prompt("Skopiuj swój kod zapisu:", code);
  } catch (e) { showToast("Błąd eksportu zapisu."); }
}
function importSave() {
  const code = prompt("Wklej kod zapisu gry:"); if (!code) return;
  try {
    const dec = JSON.parse(decodeURIComponent(escape(atob(code.trim()))));
    if (dec && Array.isArray(dec.team) && dec.team.length > 0) {
      state = { shinyCaught: [], shinyCharmLevel: 0, badges: [], ...dec };
      if (!state.ballBag) state.ballBag = { poke: dec.balls || 0, great: 0, ultra: 0, master: 0 };
      saveGame(); showToast("✅ Pomyślnie wgrano zapis gry!"); render();
    } else showToast("❌ Nieprawidłowy kod zapisu!");
  } catch (e) { showToast("❌ Błędny kod zapisu!"); }
}
function resetSave() {
  if (!confirm("Czy na pewno chcesz usunąć cały swój postęp i zacząć od zera?")) return;
  if (!confirm("Ostatnie ostrzeżenie! Usunąć wszystkie monety i Pokémony?")) return;
  try { localStorage.removeItem(SAVE_KEY); localStorage.removeItem(BACKUP_KEY); } catch(e){}
  location.reload();
}
function switchTab(tab) {
  currentTab = tab;
  ["train", "gyms", "shop", "dex"].forEach(t => { document.getElementById(`view-${t}`).classList.toggle("hidden", t !== tab); document.getElementById(`tab-${t}`).classList.toggle("active", t === tab); });
  render();
}
function render() {
  document.getElementById("coins-text").innerText = state.coins;
  document.getElementById("total-balls-text").innerText = getTotalBalls();
  document.getElementById("dex-count-text").innerText = state.caught.length;
  document.getElementById("shiny-count-text").innerText = state.shinyCaught.length;
  document.getElementById("badge-count-text").innerText = state.badges.length;
  document.getElementById("perm-mult-text").innerText = getPermMult().toFixed(1);
  document.getElementById("kanto-master-badge").classList.toggle("hidden", !hasKantoBadge());
  updateComboUI();
  const activeIsShiny = isShiny(state.activeDex);
  document.getElementById("poke-arena-box").classList.toggle("shiny-arena", activeIsShiny);
  document.getElementById("active-shiny-badge").classList.toggle("hidden", !activeIsShiny);
  document.getElementById("active-img").src = getSprite(state.activeDex, activeIsShiny);
  document.getElementById("active-name").innerText = `${activeIsShiny ? "✨ " : ""}#${String(state.activeDex).padStart(3,'0')} ${KANTO_NAMES[state.activeDex]}`;
  const evoBtn = document.getElementById("evolve-btn"), evo = EVOLUTIONS[state.activeDex];
  if (!evo) { evoBtn.innerText = "⭐ MAKSYMALNA EWOLUCJA"; evoBtn.disabled = true; }
  else { evoBtn.innerText = `✨ Ewoluuj w ${KANTO_NAMES[evo[0]]} (${evo[1]} 💰)`; evoBtn.disabled = state.coins < evo[1]; }
  const wildBox = document.getElementById("wild-encounter");
  if (wildPokemon) {
    wildBox.classList.remove("hidden"); wildBox.classList.toggle("wild-shiny", !!wildPokemon.shiny);
    document.getElementById("wild-header").innerText = wildPokemon.shiny ? "✨ DZIKI SHINY POKÉMON! ✨" : "🌿 DZIKI POKÉMON!";
    document.getElementById("wild-header").style.color = wildPokemon.shiny ? "#ffd700" : "#ffcb05";
    document.getElementById("wild-img").src = getSprite(wildPokemon.dex, wildPokemon.shiny);
    const isNew = !state.caught.includes(wildPokemon.dex) || (wildPokemon.shiny && !isShiny(wildPokemon.dex));
    document.getElementById("wild-name").innerText = (wildPokemon.shiny ? "✨ Shiny " : "") + KANTO_NAMES[wildPokemon.dex] + (isNew ? " 🆕" : "");
    document.getElementById("wild-info").innerText = `Bazowa szansa: ${Math.round(wildPokemon.catchRate * 100)}% | Próby: ${wildPokemon.tries}`;
    ["poke", "great", "ultra", "master"].forEach(t => { const cnt = state.ballBag[t] || 0; const btn = document.getElementById(`throw-${t}-btn`); btn.disabled = cnt <= 0; btn.innerText = `${BALL_TYPES[t].icon} ${BALL_TYPES[t].name.split(" ")[0]} (${cnt})`; });
  } else wildBox.classList.add("hidden");
  if (currentTab === "gyms") {
    const bBox = document.getElementById("gym-battle-arena");
    if (activeGymBattle) { bBox.classList.remove("hidden"); document.getElementById("gym-boss-img").src = getSprite(activeGymBattle.gym.poke); document.getElementById("gym-boss-name").innerText = `${activeGymBattle.gym.leader}: ${KANTO_NAMES[activeGymBattle.gym.poke]}`; updateGymBattleUI(); }
    else bBox.classList.add("hidden");
    document.getElementById("badge-shelf").innerHTML = GYMS.map(g => `<span class="gym-badge-pill ${state.badges.includes(g.id) ? "earned" : ""}">${g.badge}</span>`).join("");    document.getElementById("gym-list").innerHTML = GYMS.map(g => { const b = state.badges.includes(g.id); return `<div class="gym-card ${b ? "beaten" : ""}"><div style="display:flex;align-items:center;gap:10px;"><img src="${getSprite(g.poke)}" width="46" style="image-rendering:pixelated;"><div><strong>${g.leader}</strong> (${KANTO_NAMES[g.poke]})<br><span class="sub">HP: ${g.hp} | Nagroda: ${g.reward} 💰</span></div></div><button type="button" class="shop-btn" onclick="startGymBattle(${g.id})">${b ? "Rewanż" : "Walcz!"}</button></div>`; }).join("");
  }
  if (currentTab === "shop") {
    ["poke", "great", "ultra", "master"].forEach(t => {
      document.getElementById(`inv-${t}`).innerText = state.ballBag[t] || 0;
      [1, 5, 10].forEach(q => { const b = document.getElementById(`buy-${t}-${q}`); if (b) { const price = BALL_TYPES[t].price * q; b.innerText = `x${q} (${price})`; b.disabled = state.coins < price; } });
    });
    const mPrice = getMultPrice(); document.getElementById("mult-lvl-text").innerText = state.multLevel;
    const mBtn = document.getElementById("buy-mult-btn"); mBtn.innerText = `Kup (${mPrice} 💰)`; mBtn.disabled = state.coins < mPrice;
    const sPrice = getShinyCharmPrice(), sPct = Math.round(getShinyChance() * 100); document.getElementById("shiny-chance-text").innerText = sPct;
    const sBtn = document.getElementById("buy-shiny-btn"); if (sPct >= 50) { sBtn.innerText = "MAX (50%)"; sBtn.disabled = true; } else { sBtn.innerText = `Kup (${sPrice} 💰)`; sBtn.disabled = state.coins < sPrice; }
    document.getElementById("team-count-text").innerText = state.team.length;
    const indexedTeam = state.team.map((dex, idx) => ({ dex, idx })).sort((a, b) => getBasePower(b.dex) - getBasePower(a.dex));
    let actMarked = false;
    document.getElementById("team-list").innerHTML = indexedTeam.map(item => {
      const dex = item.dex, sh = isShiny(dex), isAct = (dex === state.activeDex && !actMarked);
      if (isAct) actMarked = true;
      return `<div class="shop-item ${sh ? "shiny-item" : ""}"><div class="shop-left"><img src="${getSprite(dex, sh)}"><div><strong>${sh ? "✨ " : ""}${KANTO_NAMES[dex]}</strong><br><span class="sub">+${getClickPower(dex)} 💰 / klik</span></div></div><div class="bulk-btns">${isAct ? `<span class="active-tag">AKTYWNY</span>` : `<button type="button" class="shop-btn" onclick="selectPoke(${dex})">Wybierz</button><button type="button" class="transfer-btn" onclick="transferOnePoke(${item.idx})">Odeślij +${getTransferValue(dex)}💰</button>`}</div></div>`;
    }).join("");
  }
  if (currentTab === "dex") {
    document.getElementById("dex-progress").innerText = state.caught.length; document.getElementById("dex-shiny-progress").innerText = state.shinyCaught.length;
    let html = "";
    for (let i = 1; i <= 151; i++) { const ok = state.caught.includes(i), sh = isShiny(i); html += `<div class="dex-cell ${ok ? "caught" : ""} ${sh ? "shiny-caught" : ""}"><span class="dex-num">#${String(i).padStart(3,"0")}${sh ? " ✨" : ""}</span><img class="${ok ? "" : "silhouette"}" src="${getSprite(i, sh)}" loading="lazy"><span class="dex-label">${ok ? KANTO_NAMES[i] : "???"}</span></div>`; }
    document.getElementById("dex-grid").innerHTML = html;
  }
}
loadGame();
</script>
</body>
</html>
