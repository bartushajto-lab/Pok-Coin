  .top-stats { display: flex; justify-content: space-around; align-items: center; }
  .stat-box { font-size: 16px; font-weight: bold; }
  .coins { color: #ffd700; }
  .balls { color: #ff5252; }
  .sub { font-size: 12px; color: #9aa3b2; margin-top: 3px; }
