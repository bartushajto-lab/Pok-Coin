  .poke-img { width: 135px; height: 135px; image-rendering: pixelated; }
  .poke-name { font-size: 21px; font-weight: bold; margin-top: 4px; }
  .shiny-pill { display: inline-block; background: linear-gradient(90deg, #ffcb05, #ff9800); color: #14171d; font-size: 11px; font-weight: bold; padding: 2px 8px; border-radius: 8px; margin-bottom: 4px; }
  .wild-box { background: #27213b; border: 2px solid #ffcb05; }
  .wild-box.wild-shiny { background: radial-gradient(circle at center, #3d3114 0%, #27213b 80%); border: 2px solid #ffd700; box-shadow: 0 0 20px rgba(255, 215, 0, 0.45); }
  .ball-throw-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px; margin-top: 10px; }
  .throw-type-btn { padding: 9px 6px; border: none; border-radius: 10px; font-weight: bold; font-size: 12px; color: #fff; }
  .throw-type-btn:disabled { background: #323947 !important; color: #6c768a; }
  .action-btn { width: 100%; padding: 12px; margin-top: 10px; border: none; border-radius: 12px; font-size: 14px; font-weight: bold; background: #ffcb05; color: #14171d; }
  .action-btn:disabled { background: #363d4d; color: #758096; }
  .run-btn { background: #454d5e; color: #fff; margin-top: 8px; padding: 9px; font-size: 13px; }
  .shop-item { display: flex; align-items: center; justify-content: space-between; background: #161a22; padding: 10px; border-radius: 12px; margin-top: 8px; border: 1px solid #262c3a; gap: 8px; }
  .shop-item.shiny-item { border-color: #b8860b; background: #1f1d16; }
  .shop-left { display: flex; align-items: center; gap: 8px; text-align: left; }
  .shop-left img { width: 44px; height: 44px; image-rendering: pixelated; }
  .bulk-btns { display: flex; gap: 4px; flex-wrap: wrap; justify-content: flex-end; }
  .shop-btn { padding: 7px 9px; border: none; border-radius: 8px; font-weight: bold; font-size: 11px; background: #2a75bb; color: #fff; }
  .shop-btn:disabled { background: #323947; color: #6c768a; }
  .transfer-btn { padding: 7px 8px; border: none; border-radius: 8px; font-weight: bold; font-size: 11px; background: #c62828; color: #fff; }
  .active-tag { background: #388e3c; padding: 6px 9px; border-radius: 8px; font-size: 11px; font-weight: bold; }
  .gym-grid { display: flex; flex-direction: column; gap: 8px; margin-top: 10px; }
  .gym-card { display: flex; align-items: center; justify-content: space-between; background: #161a22; padding: 10px 12px; border-radius: 12px; border: 1px solid #2c3342; text-align: left; }
  .gym-card.beaten { border-color: #4caf50; background: #17261c; }
  .gym-battle-box { background: #2b1922; border: 2px solid #ff5252; padding: 14px; border-radius: 16px; margin-bottom: 12px; }
  .hp-track { width: 100%; height: 14px; background: #141820; border-radius: 7px; overflow: hidden; margin: 8px 0; border: 1px solid #444; }
  .hp-fill { height: 100%; width: 100%; background: linear-gradient(90deg, #4caf50, #8bc34a); transition: width 0.1s; }
  .badge-shelf { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; margin-top: 8px; }
  .gym-badge-pill { font-size: 11px; padding: 4px 8px; border-radius: 8px; background: #262c3a; color: #758096; border: 1px solid #363f52; }
  .gym-badge-pill.earned { background: #2a3b2c; color: #a5d6a7; border-color: #4caf50; font-weight: bold; }
  .dex-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; max-height: 440px; overflow-y: auto; margin-top: 10px; }
  .dex-cell { background: #161a22; border-radius: 10px; padding: 6px 2px; display: flex; flex-direction: column; align-items: center; border: 1px solid #282f3d; }
  .dex-cell.caught { border-color: #ffcb05; background: #212734; }
  .dex-cell.shiny-caught { border-color: #ffd700; background: #2c2718; box-shadow: inset 0 0 8px rgba(255,215,0,0.3); }
  .dex-cell img { width: 54px; height: 54px; image-rendering: pixelated; }
  .dex-cell img.silhouette { filter: brightness(0) opacity(0.35); }
  .dex-num { font-size: 10px; color: #8892a4; }
  .dex-label { font-size: 11px; font-weight: bold; max-width: 72px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .save-panel { display: flex; flex-direction: column; align-items: center; gap: 8px; margin-top: 8px; padding-bottom: 16px; }
  .save-status { font-size: 11px; color: #4caf50; }
  .backup-btns { display: flex; gap: 8px; justify-content: center; }
  .backup-btn { background: #262c3a; border: 1px solid #3c4559; color: #cbd5e1; font-size: 12px; padding: 7px 12px; border-radius: 8px; }
  .reset-link { background: none; border: none; color: #6c768a; font-size: 11px; margin-top: 6px; text-decoration: underline; }
  .hidden { display: none !important; }
</style>
